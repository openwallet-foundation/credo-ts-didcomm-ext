{
  "name": "@credo-ts/didcomm-media-sharing",
  "version": "0.2.0",
  "description": "DIDComm Media sharing protocol implementation for credo-ts",
  "homepage": "https://github.com/openwallet-foundation/credo-ts-didcomm-ext/tree/main/packages/media-sharing",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./build/index.mjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    },
    "./drizzle": {
      "types": "./build/drizzle/bundle.d.mts",
      "default": "./build/drizzle/bundle.mjs"
    },
    "./drizzle/sqlite": {
      "types": "./build/drizzle/sqlite.d.mts",
      "default": "./build/drizzle/sqlite.mjs"
    },
    "./drizzle/postgres": {
      "types": "./build/drizzle/postgres.d.mts",
      "default": "./build/drizzle/postgres.mjs"
    },
    "./drizzle/migrations/sqlite": {
      "types": "./migrations/sqlite/migrations.d.ts",
      "default": "./migrations/sqlite/migrations.js"
    }
  },
  "files": [
    "build",
    "migrations"
  ],
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "clean": "rimraf -rf ./build",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openwallet-foundation/credo-ts-didcomm-ext",
    "directory": "packages/media-sharing"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@credo-ts/askar": "^0.7.2",
    "@credo-ts/core": "^0.7.2",
    "@credo-ts/didcomm": "^0.7.2",
    "@credo-ts/drizzle-storage": "^0.7.4",
    "@credo-ts/node": "^0.7.2",
    "@openwallet-foundation/askar-nodejs": "0.6.0",
    "@openwallet-foundation/askar-shared": "0.6.0",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.0",
    "drizzle-orm": "^0.44.7",
    "tsconfig-paths": "^3.10.1",
    "tsdown": "^0.16.8",
    "typescript": "~5.9.3",
    "vitest": "^4.0.7"
  },
  "peerDependencies": {
    "@credo-ts/core": "^0.7.2",
    "@credo-ts/didcomm": "^0.7.2",
    "@credo-ts/drizzle-storage": "^0.7.4",
    "drizzle-orm": "^0.44.6 || ^0.45.0"
  },
  "peerDependenciesMeta": {
    "@credo-ts/drizzle-storage": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "tsyringe": "^4.10.0",
    "uuid": "^9.0.0"
  }
}
