{
  "name": "credo-ts-didcomm-ext",
  "private": true,
  "license": "Apache-2.0",
  "description": "Monorepo containing DIDComm extensions for Credo",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "url": "https://github.com/openwallet-foundation/credo-ts-didcomm-ext",
    "type": "git"
  },
  "scripts": {
    "check-types": "pnpm run check-types:build && pnpm run check-types:tests",
    "check-types:tests": "tsc -p tsconfig.test.json --noEmit",
    "check-types:build": "pnpm -r --filter './packages/*' exec tsc --noEmit -p tsconfig.build.json",
    "test": "vitest -c vitest.config.base.ts run",
    "validate": "pnpm style:check && pnpm check-types",
    "style:check": "biome check --unsafe",
    "style:fix": "biome check --write --unsafe",
    "changeset-version": "pnpm changeset version && pnpm style:fix",
    "release": "pnpm -r build && pnpm changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^3.0.3",
    "@credo-ts/askar": "^0.7.4",
    "@credo-ts/core": "^0.7.4",
    "@credo-ts/didcomm": "^0.7.4",
    "@credo-ts/drizzle-storage": "^0.7.4",
    "@credo-ts/node": "^0.7.4",
    "@libsql/client": "^0.18.0",
    "@openwallet-foundation/askar-nodejs": "0.6.0",
    "@openwallet-foundation/askar-shared": "0.6.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.0.15",
    "class-transformer": "0.5.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.44.7",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "tsdown": "^0.16.7",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.8"
    },
    "ignoredBuiltDependencies": [
      "es5-ext"
    ],
    "onlyBuiltDependencies": [
      "@openwallet-foundation/askar-nodejs",
      "koffi"
    ]
  },
  "resolutions": {
    "@jest/types": "^29.5.0",
    "@types/node": "^20.19.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
